# Global gitignore — patterns that should never be committed to ANY repo.
# Git reads this automatically from $XDG_CONFIG_HOME/git/ignore.
# Project-specific patterns belong in the repo's own .gitignore, not here.

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
.directory
.fuse_hidden*
.nfs*

# ── Editors & IDEs ───────────────────────────────────────────────────────────
*.swp
*.swo
*~
.netrwhist
tags
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.nvim.lua
.exrc

# ── Direnv / local env ───────────────────────────────────────────────────────
.direnv/
.envrc.local

# ── Build & dependency noise that is universally unwanted ────────────────────
.cache/
*.log
*.pid

# ── Scratch files (personal convention) ──────────────────────────────────────
scratch/
*.local
