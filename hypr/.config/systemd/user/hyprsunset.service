# The packaged unit plus --identity, so the screen stays neutral until the shell asks (hypr/README.md).
[Unit]
Description=Hyprland's blue-light filter
Documentation=https://wiki.hyprland.org/Hypr-Ecosystem/hyprsunset/
PartOf=graphical-session.target
Requires=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/hyprsunset --identity
Slice=session.slice
Restart=on-failure

[Install]
WantedBy=graphical-session.target
