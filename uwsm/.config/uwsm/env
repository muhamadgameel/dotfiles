# Sourced by uwsm before the compositor starts, so these reach systemd and D-Bus
# activated apps too (hypr/README.md#environment). Log in again to apply.

# ── PATH and default apps ───────────────────────────────────────────
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim
export TERMINAL=alacritty
export PAGER=less

# ── Cursor ──────────────────────────────────────────────────────────
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24
export HYPRCURSOR_THEME=Adwaita
export HYPRCURSOR_SIZE=24

# ── Toolkit backends ────────────────────────────────────────────────
# Fallback lists, so an app missing its Wayland plugin uses X11 instead of failing.
export GDK_BACKEND=wayland,x11,*
export QT_QPA_PLATFORM='wayland;xcb'

# Electron/Chromium: pick Wayland when the session is Wayland.
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Hyprland draws the decorations, so Qt should not.
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

# QT_AUTO_SCREEN_SCALE_FACTOR stays unset: on 1.333x it double-scales XWayland Qt apps.

# uwsm sets the XDG_* session variables itself -- do not duplicate them here.
